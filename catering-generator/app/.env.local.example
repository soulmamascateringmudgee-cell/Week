NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_4hAnkF_WGnWSKkJkumaHIg_HLVrBxmz

# Server-only. Creates accounts for people already on the invite list, which
# nothing running as `anon` is allowed to do. Supabase dashboard → Project
# Settings → API keys → the secret key (older projects call it service_role).
# No NEXT_PUBLIC_ prefix, deliberately — this must never reach the browser.
SUPABASE_SECRET_KEY=

# Sending the invite email. Resend → API Keys, and a verified sending domain.
# Without these the invite still saves; the admin page says it wasn't sent and
# gives you the link to send yourself.
RESEND_API_KEY=
EMAIL_FROM="Jessmyn @ Prep & Ordering <hello@yourdomain.com.au>"
EMAIL_FROM_NAME=Jessmyn
EMAIL_REPLY_TO=jessmyn.toovey@hotmail.com
